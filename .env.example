NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://gbs:12345@127.0.0.1:5433/gbs_publication?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
CLERK_SECRET_KEY=replace-with-clerk-secret
CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key

# Local MinIO storage. Keep this for local-only development.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gbs-publication
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Cloudflare R2 storage. Use these values instead of the MinIO values above
# when you want production/dev uploads to go to R2.
# S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<R2_BUCKET_NAME>
# S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# S3_FORCE_PATH_STYLE=false

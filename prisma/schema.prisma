generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  AUTHOR
  PUBLISHER_ADMIN
  EDITOR
  BOOKSTORE_PARTNER
  LIBRARY_BUYER
  RIGHTS_BUYER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
}

enum BookFormat {
  EBOOK
  PAPERBACK
  HARDCOVER
  AUDIOBOOK
  SERIAL
}

enum FileAssetType {
  MANUSCRIPT
  COVER
  EPUB
  PDF
  AUDIO
  SAMPLE
  EXPORT
}

enum FileProcessingStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
  FAILED
}

enum RoyaltyLedgerStatus {
  ESTIMATED
  SETTLED
  PAID
  VOIDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model User {
  id                   String              @id @default(cuid())
  clerkId              String              @unique
  email                String              @unique
  name                 String?
  roles                UserRole[]          @default([READER])
  profiles             Profile[]
  projects             BookProject[]
  orders               Order[]             @relation("ReaderOrders")
  libraryItems         ReaderLibraryItem[] @relation("ReaderLibraryItems")
  royaltyLedgers       RoyaltyLedger[]     @relation("CreatorRoyaltyLedgers")
  readingProgressItems ReadingProgress[]   @relation("ReaderProgressItems")
  bookmarks            ReaderBookmark[]    @relation("ReaderBookmarks")
  highlights           ReaderHighlight[]   @relation("ReaderHighlights")
  reviews              Review[]            @relation("ReaderReviews")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String
  displayName String
  slug        String?  @unique
  bio         String?
  avatarUrl   String?
  penName     String?
  isPublic    Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookProject {
  id                   String              @id @default(cuid())
  ownerId              String
  title                String
  slug                 String?             @unique
  subtitle             String?
  description          String?
  language             String              @default("en")
  status               ProjectStatus       @default(DRAFT)
  genre                String?
  tags                 String[]            @default([])
  ageRating            String?
  keywords             String[]            @default([])
  coverFileId          String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  publishedAt          DateTime?
  rejectionReason      String?
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  editions             Edition[]
  files                FileAsset[]
  orderItems           OrderItem[]
  libraryItems         ReaderLibraryItem[]
  royaltyLedgers       RoyaltyLedger[]
  readingProgressItems ReadingProgress[]
  bookmarks            ReaderBookmark[]
  highlights           ReaderHighlight[]
  reviews              Review[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([genre])
  @@index([publishedAt])
}

model Edition {
  id                   String              @id @default(cuid())
  projectId            String
  format               BookFormat
  isbn                 String?
  price                Decimal?            @db.Decimal(10, 2)
  currency             String              @default("USD")
  isPublished          Boolean             @default(false)
  project              BookProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderItems           OrderItem[]
  libraryItems         ReaderLibraryItem[]
  royaltyLedgers       RoyaltyLedger[]
  readingProgressItems ReadingProgress[]
  bookmarks            ReaderBookmark[]
  highlights           ReaderHighlight[]
  reviews              Review[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model FileAsset {
  id               String               @id @default(cuid())
  projectId        String?
  ownerId          String
  type             FileAssetType
  originalName     String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  processingStatus FileProcessingStatus @default(PENDING)
  project          BookProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  readerId        String
  status          OrderStatus @default(PENDING)
  currency        String      @default("USD")
  subtotalAmount  Decimal     @db.Decimal(10, 2)
  platformFee     Decimal     @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  paymentProvider String?
  paymentRef      String?
  paidAt          DateTime?
  refundedAt      DateTime?
  reader          User        @relation("ReaderOrders", fields: [readerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([readerId])
  @@index([status])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  projectId     String
  editionId     String
  quantity      Int            @default(1)
  unitPrice     Decimal        @db.Decimal(10, 2)
  currency      String         @default("USD")
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  project       BookProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition       Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  royaltyLedger RoyaltyLedger?
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@index([projectId])
  @@index([editionId])
}

model ReaderLibraryItem {
  id          String      @id @default(cuid())
  readerId    String
  projectId   String
  editionId   String
  orderItemId String?
  acquiredVia String      @default("PURCHASE")
  reader      User        @relation("ReaderLibraryItems", fields: [readerId], references: [id], onDelete: Cascade)
  project     BookProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition     Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([readerId, editionId])
  @@index([readerId])
  @@index([projectId])
}

model RoyaltyLedger {
  id          String              @id @default(cuid())
  orderItemId String              @unique
  projectId   String
  editionId   String
  creatorId   String
  grossAmount Decimal             @db.Decimal(10, 2)
  platformFee Decimal             @db.Decimal(10, 2)
  creatorNet  Decimal             @db.Decimal(10, 2)
  currency    String              @default("USD")
  status      RoyaltyLedgerStatus @default(SETTLED)
  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  project     BookProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition     Edition             @relation(fields: [editionId], references: [id], onDelete: Cascade)
  creator     User                @relation("CreatorRoyaltyLedgers", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([creatorId])
  @@index([projectId])
  @@index([status])
}

model ReadingProgress {
  id             String      @id @default(cuid())
  readerId       String
  projectId      String
  editionId      String
  currentLocator String?
  percentage     Decimal     @default(0) @db.Decimal(5, 2)
  lastReadAt     DateTime    @default(now())
  reader         User        @relation("ReaderProgressItems", fields: [readerId], references: [id], onDelete: Cascade)
  project        BookProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition        Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([readerId, editionId])
  @@index([readerId])
  @@index([projectId])
}

model ReaderBookmark {
  id        String      @id @default(cuid())
  readerId  String
  projectId String
  editionId String
  locator   String
  label     String?
  note      String?
  reader    User        @relation("ReaderBookmarks", fields: [readerId], references: [id], onDelete: Cascade)
  project   BookProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition   Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([readerId])
  @@index([editionId])
}

model ReaderHighlight {
  id           String      @id @default(cuid())
  readerId     String
  projectId    String
  editionId    String
  locatorStart String
  locatorEnd   String?
  textSnippet  String?
  color        String?
  note         String?
  reader       User        @relation("ReaderHighlights", fields: [readerId], references: [id], onDelete: Cascade)
  project      BookProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition      Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([readerId])
  @@index([editionId])
}

model Review {
  id                 String       @id @default(cuid())
  readerId           String
  projectId          String
  editionId          String?
  rating             Int
  text               String?
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  spoilerFlag        Boolean      @default(false)
  moderatedAt        DateTime?
  moderationNote     String?
  reader             User         @relation("ReaderReviews", fields: [readerId], references: [id], onDelete: Cascade)
  project            BookProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edition            Edition?     @relation(fields: [editionId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([readerId, projectId])
  @@index([projectId])
  @@index([readerId])
  @@index([status])
  @@index([rating])
}
